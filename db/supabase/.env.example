# Copy this to .env — never commit .env to git
# Add .env to your .gitignore

# ── Supabase (recommended for team sharing) ──────────────────
# Get from: supabase.com → your project → Settings → Database → URI
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── DigitalOcean Managed PostgreSQL ──────────────────────────
# Get from: cloud.digitalocean.com → Databases → your cluster → Connection Details → URI
# DATABASE_URL=postgresql://doadmin:[PASSWORD]@[HOST].db.ondigitalocean.com:25060/defaultdb?sslmode=require

# ── Local Docker (development only) ──────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/pos_db

# ── Anthropic API (for the agent — not needed for DB seeding) ──
ANTHROPIC_API_KEY=sk-ant-your-key-here
