\f0\fs24 \cf0 -- Add dispute and loyalty columns\
ALTER TABLE transactions\
  ADD COLUMN IF NOT EXISTS dispute_status          VARCHAR(20)  DEFAULT NULL,\
  ADD COLUMN IF NOT EXISTS dispute_id              UUID         DEFAULT NULL,\
  ADD COLUMN IF NOT EXISTS disputed_at             TIMESTAMP    DEFAULT NULL,\
  ADD COLUMN IF NOT EXISTS resolved_at             TIMESTAMP    DEFAULT NULL,\
  ADD COLUMN IF NOT EXISTS loyalty_points_earned   INTEGER      DEFAULT 0,\
  ADD COLUMN IF NOT EXISTS loyalty_points_credited BOOLEAN      DEFAULT FALSE;\
\
-- Calculate and populate loyalty points for existing approved purchases\
UPDATE transactions\
SET loyalty_points_earned = FLOOR(amount / 100)\
WHERE status = 'APPROVED'\
  AND transaction_type = 'PURCHASE'\
  AND currency = 'RSD';\
\
-- Create loyalty_accounts if not exists\
CREATE TABLE IF NOT EXISTS loyalty_accounts (\
    account_id   UUID PRIMARY KEY DEFAULT gen_random_uuid(),\
    pan_masked   VARCHAR(19) NOT NULL UNIQUE,\
    points       INTEGER DEFAULT 0,\
    tier         VARCHAR(20) DEFAULT 'STANDARD',\
    total_spent  NUMERIC(12,2) DEFAULT 0,\
    last_updated TIMESTAMP DEFAULT NOW()\
);\
\
-- Indexes\
CREATE INDEX IF NOT EXISTS idx_dispute_status     ON transactions (dispute_status);\
CREATE INDEX IF NOT EXISTS idx_dispute_id         ON transactions (dispute_id);\
CREATE INDEX IF NOT EXISTS idx_loyalty_credited   ON transactions (loyalty_points_credited);\
CREATE INDEX IF NOT EXISTS idx_approval_code_pan  ON transactions (approval_code, pan_masked);}